# Sandbox image for qa-agent-evals SUT sessions (knowledge/sandbox.md).
# Only the Claude Code CLI and a minimal runtime; no credentials in the image.
# Build: docker build -t qa-evals-sandbox:latest -f scripts/Dockerfile.sandbox scripts/
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends git procps \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code

# the node user already exists in the base image with UID 1000 -
# creating our own with the same UID fails (useradd: exit 4).
# CLI service dirs are pre-created with node ownership: a tmpfs
# mounted on top inherits the ownership of the mount point
RUN mkdir -p /home/node/.claude && chown -R node:node /home/node
USER node
WORKDIR /workspace
